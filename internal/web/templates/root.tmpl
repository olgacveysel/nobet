{{define "content"}}
<h1>Root access</h1>
<p class="sub">Who can become root on which host, and how, grouped by SSH key, from each host's newest successful scan. Routes: direct UID 0 login (respecting PermitRootLogin and Match blocks), sudo as resolved by sudo itself, limited sudo rules that escape to a shell, and root-equivalent groups.</p>
{{if .Empty}}<p class="muted">No scans yet.</p>{{else}}
{{with .Map}}
{{if not .Keys}}<p>No SSH key leads to root on the scanned hosts.</p>{{end}}
{{range .Keys}}
<section class="key">
  <div class="fp"><code>{{.Fingerprint}}</code> · {{.Type}}{{range .Comments}} · {{.}}{{end}}</div>
  <div class="muted">root on {{.Hosts}} host(s)</div>
  <div class="wrap">
  <table>
    <thead><tr><th>Host</th><th>As user</th><th>Route to root</th><th>Restrictions</th></tr></thead>
    <tbody>{{range .Grants}}<tr><td><a href="/host/{{.Host}}">{{.Host}}</a></td><td><code>{{.User}}</code></td><td>{{routes .Routes}}</td><td>{{.Restricted}}</td></tr>{{end}}</tbody>
  </table>
  </div>
</section>
{{end}}
{{if .KeylessUsers}}
<h2>Root-capable accounts without SSH key access</h2>
<div class="wrap"><table>
  <thead><tr><th>Host</th><th>Account</th><th>Route to root</th></tr></thead>
  <tbody>{{range .KeylessUsers}}<tr><td><a href="/host/{{.Host}}">{{.Host}}</a></td><td><code>{{.User}}</code></td><td>{{routes .Routes}}</td></tr>{{end}}</tbody>
</table></div>
{{end}}
{{if .Gaps}}
<h2>Incomplete</h2>
<ul class="plain muted">{{range .Gaps}}<li><b>{{.Host}}</b>: {{.Reason}}</li>{{end}}</ul>
{{end}}
{{end}}
{{end}}
{{end}}
