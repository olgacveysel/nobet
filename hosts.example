# One host per line: [user@]host[:port]
# Lines starting with # are ignored. The default user is your local username (or -u).
# An Ansible INI inventory works too (with -group to pick groups), and so does
# the JSON of `ansible-inventory -i <inventory> --list` for YAML ones.
web01.example.com
admin@db01.example.com
deploy@10.0.0.15:2222
