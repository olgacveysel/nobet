# Read-only dashboard over the scans that nobet-scan.service saves.
# Runs as its own account in the nobet group: it can read the scan history
# but not the scanner's SSH key, and it never connects to your servers.
# Keep it on localhost behind a reverse proxy that authenticates your team,
# or let it sign users in with your OpenID Connect provider (below).
[Unit]
Description=nöbet dashboard (read-only)
Documentation=https://github.com/olgacveysel/nobet
After=network.target

[Service]
User=nobet-web
Group=nobet-web
SupplementaryGroups=nobet
Environment=NOBET_DATA_DIR=/var/lib/nobet
# Add -user-header with the header your proxy sets for the signed-in user
# (X-Forwarded-User, Remote-User, ...) to log who viewed what.
ExecStart=/usr/bin/nobet-web -listen 127.0.0.1:8080
Restart=on-failure
# The audit log (-audit-log /var/log/nobet-web/audit.jsonl) goes here.
LogsDirectory=nobet-web
LogsDirectoryMode=0750

# Built-in sign-in instead of a proxy (README, "Sign-in"). nobet-web then
# talks to your identity provider, so allow its address below (or drop the
# two IPAddress lines). For example, with `systemctl edit nobet-web`:
#   [Service]
#   ExecStart=
#   ExecStart=/usr/bin/nobet-web -listen 127.0.0.1:8080 -public-url https://nobet.example.com \
#     -oidc-issuer https://login.example.com/realms/ops -oidc-client-id nobet \
#     -oidc-client-secret-file /etc/nobet/oidc-secret -allow-groups nobet-viewers \
#     -session-key-file /etc/nobet/session-key -audit-log /var/log/nobet-web/audit.jsonl
#   IPAddressAllow=192.0.2.10

# Hardening: read-only everywhere, no access to the scanner's key, and
# only local network traffic (from the reverse proxy).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/var/lib/nobet/.ssh
# With -scan-queue /var/lib/nobet/queue it may write scan requests there
# (nothing else); nobet-scan-queue.path picks them up.
ReadWritePaths=-/var/lib/nobet/queue
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
IPAddressDeny=any
IPAddressAllow=localhost
