#!/bin/sh
# Entry point of the scanner image: runs `nobet scan` now, then every
# NOBET_INTERVAL (a sleep duration such as 24h or 6h; "once" scans once and
# exits). Configuration is mounted at /etc/nobet and the SSH key comes in as
# the ssh_key secret; see compose.yaml.
set -u
conf=/etc/nobet
key=${NOBET_SSH_KEY:-/run/secrets/ssh_key}
interval=${NOBET_INTERVAL:-24h}

for f in "$conf/hosts" "$conf/known_hosts" "$key"; do
  if [ ! -r "$f" ]; then
    echo "nobet-scan: cannot read $f (it must exist and be readable by uid $(id -u)); see the Docker section of the README" >&2
    exit 2
  fi
done

set -- -plain -i "$conf/hosts" -identity "$key" -known-hosts "$conf/known_hosts"
if [ -f "$conf/allowlist" ]; then set -- "$@" -allow "$conf/allowlist"; fi
if [ -f "$conf/ssh_config" ]; then set -- "$@" -F "$conf/ssh_config"; else set -- "$@" -no-ssh-config; fi

while :; do
  nobet scan "$@"
  rc=$?
  case $rc in
    0|1|3) ;; # 1: findings reported, 3: some hosts unreachable; the scan was saved
    2) echo "nobet-scan: configuration error, stopping" >&2; exit 2 ;;
    *) echo "nobet-scan: scan failed with exit status $rc" >&2 ;;
  esac
  [ "$interval" = once ] && exit "$rc"
  sleep "$interval"
done
